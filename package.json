{
  "name": "b1web-next",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/erp-smoke.ts",
    "db:reset": "node -e \"const fs=require('fs');fs.rmSync('.data',{recursive:true,force:true});if(fs.existsSync('.data')){console.error('[db:reset] .data 삭제 실패 — dev 서버가 DB 를 잡고 있습니다. 서버를 끄고 다시 실행하세요.');process.exit(1)}console.log('[db:reset] 완료 — 다음 실행 때 재시드됩니다')\"",
    "verify": "npm run lint && npm run typecheck && npm run smoke",
    "lock:fix": "node scripts/sync-lock-wasm-deps.mjs",
    "shots": "tsx scripts/shots.mts",
    "turso:reset": "tsx scripts/turso-reset.mts",
    "turso:verify": "tsx scripts/turso-verify.mts"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libsql": "^0.5.29",
    "next": "16.2.10",
    "pretendard": "^1.3.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "puppeteer-core": "^25.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.5",
    "typescript": "^5"
  }
}
