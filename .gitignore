# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# 데모 SQLite DB — 첫 실행 때 시드로 자동 생성된다 (npm run db:reset 으로 재생성)
/.data/

# 외부 디자인 목업 원본 (샘플 데이터에 실존 상호가 섞여 있어 공개 대상 아님)
docs/새 폴더/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 내부 작업 문서 — 로컬에만 둔다.
# 원본(사내 시스템) 역설계 산출물이라 공개 저장소에 두지 않는다. 코드·README·ADR 만 공개.
docs/conversion/
docs/progress/
docs/screens/
