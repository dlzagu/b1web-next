# 전부 선택 사항 — 아무것도 설정하지 않아도 `npm run dev` 로 바로 동작한다.
# (데모 SQLite DB 가 첫 실행 때 .data/b1web.db 로 자동 생성 + 가상 시드)

# 데모 DB 경로. 미설정 시 .data/b1web.db (Vercel 등 서버리스는 자동으로 :memory:)
# DATABASE_PATH=.data/b1web.db

# 공유 데모 DB (Turso/libSQL). 설정하면 로컬 파일·메모리 대신 이쪽이 정본이 되고,
# 모든 인스턴스가 같은 데이터를 본다 → 서버리스에서도 생성한 문서가 남는다.
# 로컬 개발에는 보통 설정하지 않는다(파일 DB 가 빠르고, 공유본을 더럽히지 않는다).
# 원격 시드·초기화는 `npm run turso:reset` 이 전담한다 — 앱은 원격을 자동 시드하지 않는다.
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# 세션 서명 키 (미설정 시 개발용 기본값 사용 — 배포 시에는 반드시 설정)
# AUTH_SECRET=change-me-32bytes-hex

# 데모 로그인 계정 재정의 (미설정 시 README 의 데모 계정)
# AUTH_DEV_USER=demo
# ⚠️ bcrypt 해시의 '$'는 Next(@next/env dotenv-expand)가 변수확장하므로 반드시 \$ 로 이스케이프
# AUTH_DEV_PASSWORD_HASH=
